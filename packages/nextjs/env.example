# Template for packages/nextjs/.env.local. Copy it with: cp env.example .env.local
# For Vercel, set these in the project's environment settings instead.

# Optional: your own RPC endpoints. Public ApeChain RPCs are used when empty.
NEXT_PUBLIC_CURTIS_RPC_URL=
NEXT_PUBLIC_APECHAIN_RPC_URL=

# WalletConnect / Reown project ID for the non-Glyph wallets (https://cloud.reown.com).
# A shared Scaffold-ETH default is used when empty; set your own for production.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
