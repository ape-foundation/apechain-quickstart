# Template for packages/foundry/.env (copied automatically on `yarn install` if missing).
# Never commit real values.

# ApeScan API key. ApeScan runs on the Etherscan V2 multichain API, so a key from
# https://etherscan.io/myapikey works for Curtis (33111) and ApeChain (33139).
# Used by `yarn verify`.
ETHERSCAN_API_KEY=

# Deployer accounts are encrypted keystores in ~/.foundry/keystores (created by `yarn generate` or
# `yarn account:import`). `yarn deploy` asks which one to use, or pass `--keystore <name>`.
