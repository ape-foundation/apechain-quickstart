# Template for packages/hardhat/.env. Copy it with: cp env.example .env
# Never commit real values.

# Optional: your own RPC endpoints. Public ApeChain RPCs are used when empty.
CURTIS_RPC_URL=
APECHAIN_RPC_URL=

# ApeScan API key (Etherscan V2 multichain key from https://etherscan.io/myapikey).
# Used by `yarn hardhat:verify`.
ETHERSCAN_API_KEY=

# Encrypted deployer key. Filled in by `yarn hardhat:generate` or `yarn hardhat:account-import`.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=
